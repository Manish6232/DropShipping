# Create this key at https://resend.com/api-keys and add it to your hosting environment.
RESEND_API_KEY=re_your_api_key

# Use this sender while testing. It can only deliver to your Resend account email.
EMAIL_FROM="FLCommerce <onboarding@resend.dev>"

# For production, verify a domain you own and replace EMAIL_FROM with it:
# EMAIL_FROM="FLCommerce <applications@yourdomain.com>"
